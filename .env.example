# Resend email delivery (contact form)
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=

# Inbox that receives contact enquiries.
SALES_EMAIL=sales@taplino.ch

# Verified sender address (must belong to a domain verified in Resend).
RESEND_FROM=Taplino <noreply@taplino.ch>

# Taplino backend base URL (no trailing slash). Used server-side to sync plan
# and card prices plus card availability, to create card orders (Stripe
# checkout) and to show the order confirmation. Unset = hardcoded prices and
# ordering is unavailable.
TAPLINO_API_URL=http://localhost:3311

# Public base URL of the Taplino app (no trailing slash). The order
# confirmation page links to its register page so customers can manage their
# cards.
NEXT_PUBLIC_APP_URL=http://localhost:3310
